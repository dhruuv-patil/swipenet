{
  "name": "swipenet",
  "version": "1.0.0",
  "description": "SwipeNet - Tinder for Jobs & Networking",
  "homepage": "https://github.com/dhruuv-patil/SwipeNet#readme",
  "bugs": {
    "url": "https://github.com/dhruuv-patil/SwipeNet/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dhruuv-patil/SwipeNet.git"
  },
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "start": "npm run dev",
    "server": "npm --prefix swipenet-server start",
    "client": "npm --prefix swipenet-client dev",
    "seed": "npm --prefix swipenet-server run seed",
    "build": "npm --prefix swipenet-client run build"
  },
  "dependencies": {
    "express": "^5.1.0",
    "mongoose": "^8.16.2",
    "react-icons": "^5.5.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
